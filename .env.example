# ─────────────────────────────────────────────────────────────
#  FÉNIX · Recolección y Envíos  —  variables de entorno
#  Copia este archivo a .env.local (local) y cárgalo en Vercel
#  (Project → Settings → Environment Variables).
# ─────────────────────────────────────────────────────────────

# ── Base de datos (Aiven for PostgreSQL) ─────────────────────
# Consola Aiven → tu servicio PostgreSQL → "Service URI". Pega aquí la URI completa.
# Formato: postgres://avnadmin:PASSWORD@HOST:PUERTO/defaultdb?sslmode=require
DATABASE_URL=

# Certificado CA del servicio (Aiven → Overview → "CA certificate" → Download).
# Opción A (recomendada en Vercel): pega el contenido PEM en una sola línea,
#   reemplazando los saltos de línea por \n
# Opción B (local): guarda el archivo en certs/aiven-ca.pem y usa DATABASE_CA_CERT_PATH
DATABASE_CA_CERT=
DATABASE_CA_CERT_PATH=certs/aiven-ca.pem

# Si NO configuras el CA, la conexión sigue cifrada pero sin verificar el servidor
# (se registra una advertencia). Para producción configura el CA.

# Solo para un PostgreSQL LOCAL de desarrollo (sin SSL). Se ignora en producción.
# DATABASE_SSL=off

# Pool de conexiones por instancia (en Vercel mantenlo bajo: 2–5)
DATABASE_POOL_MAX=3

# ── Sesión y seguridad ───────────────────────────────────────
# Genera uno con:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ── Primer administrador (solo lo usa `npm run db:seed`) ─────
ADMIN_EMAIL=
ADMIN_NAME=Administrador
# Mínimo 12 caracteres. Cámbiala desde el panel después del primer ingreso.
ADMIN_PASSWORD=

# ── Sitio ────────────────────────────────────────────────────
# URL pública (sin / final). Se usa para SEO, sitemap y Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
