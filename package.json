{
  "name": "fenix-envios",
  "version": "1.0.0",
  "private": true,
  "description": "Sitio y panel de administración de Fénix · Recolección y Envíos",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
